# ---------------------------------------------------------------------------
# Finder Network — root env (copy to .env and fill in)
# Local Postgres is managed with pgAdmin4; no Docker.
# This machine runs Postgres v17 on 5432 and v18 on 5433 — postgres/postgres
# authenticates on 5433.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/finder_network?schema=public"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

API_PORT=5020
API_URL="http://localhost:5020"

WEB_PORT=3020
ADMIN_PORT=3021
NEXT_PUBLIC_APP_URL="http://localhost:3020"
CORS_ORIGINS="http://localhost:3020,http://localhost:3021"
