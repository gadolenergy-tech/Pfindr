DATABASE_URL="postgresql://postgres:postgres@localhost:5433/finder_network?schema=public"
PORT=5020
NODE_ENV=development

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

CORS_ORIGINS="http://localhost:3020,http://localhost:3021"
WEB_URL="http://localhost:3020"
LOG_LEVEL="info"

# Paystack — powers "Buy now". Test keys: dashboard → Settings → API Keys.
# Leave empty to disable checkout (Buy now then explains it is unavailable).
# Webhook URL to set in the dashboard: <web origin>/api/proxy/webhooks/paystack
PAYSTACK_SECRET_KEY=""
CHECKOUT_HOLD_MINUTES=30

# Resend — verification codes and password-reset links.
# Leave RESEND_API_KEY empty in development: codes and links are logged instead.
# EMAIL_FROM must be on a domain verified in Resend (the default only reaches
# the account owner's own address).
RESEND_API_KEY=""
EMAIL_FROM="Finder Network <onboarding@resend.dev>"

# Image uploads (vendor logos, product photos) — any S3-compatible bucket.
# Leave empty to disable uploads; the upload buttons then explain it is unavailable.
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. eu-west-1).
# S3_PUBLIC_URL is where objects are served from (R2 public bucket URL or a CDN).
# The bucket needs a CORS rule allowing PUT from the web origin with the
# Content-Type header, e.g. AllowedOrigins ["http://localhost:3020"],
# AllowedMethods ["PUT"], AllowedHeaders ["*"].
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Finder's cut of each paid Buy now order, in percent. Used only by the payout
# ledger (admin → Payouts) to work out what vendors are owed. 0 until pricing is set.
PLATFORM_FEE_PERCENT=0

# Number of proxies in front of the API (rate limiting needs the real client IP).
# 2 on Railway (internal proxy + edge; the edge appends the caller's address to
# X-Forwarded-For). Behind a Vercel proxy see PROXY_SHARED_SECRET below.
# Local development has no proxy in front, so 1 is fine there.
TRUST_PROXY_HOPS=1

# Shared secret with the web/admin apps' /api/proxy (set the same value there as
# PROXY_SHARED_SECRET). Lets the API rate-limit by real visitor IP behind Vercel.
# 32+ random characters (openssl rand -hex 32). Leave empty locally.
PROXY_SHARED_SECRET=
