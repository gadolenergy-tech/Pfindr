// Finder Network — one Postgres database behind apps/api, shared by the public
// site + vendor portal (apps/web) and the operator console (apps/admin).
//
// Replaces the empty Drizzle schema that shipped with the Replit scaffold.
// Enum members mirror packages/shared/src/enums.ts — change both together.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VendorStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  FULFILLED
  CANCELLED
  REFUNDED
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum PartnerStatus {
  INQUIRY
  IN_REVIEW
  ACTIVE
  DECLINED
}

enum PartnershipType {
  TECHNOLOGY
  DISTRIBUTION
  LOGISTICS
  DATA
  RESELLER
  OTHER
}

enum ApiKeyScope {
  SEARCH_READ
  INVENTORY_READ
  INVENTORY_WRITE
  ORDERS_READ
  ORDERS_WRITE
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OrderSource {
  VENDOR
  CHECKOUT
}

enum Fulfilment {
  PICKUP
  DELIVERY
}

enum CheckoutStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  avatarUrl     String?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  vendor        Vendor?
  affiliate     Affiliate?
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  conversations Conversation[]
  orders        Order[]
  checkouts     CheckoutSession[]
  auditLogs     AuditLog[]
  vendorPayoutsRecorded VendorPayout[]

  @@index([role])
  @@index([status])
  @@map("users")
}

/// One row per issued refresh token. Logout and account suspension both work by
/// revoking here, so a stolen access token dies within ACCESS_TOKEN_TTL.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Single-use tokens for email verification and password reset. Stored hashed;
/// the plaintext only ever exists in the email that carries it.
model AuthToken {
  id        String       @id @default(cuid())
  userId    String
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Vendors
// ---------------------------------------------------------------------------

model Vendor {
  id                 String       @id @default(cuid())
  userId             String       @unique
  businessName       String
  slug               String       @unique
  description        String?
  categoryId         String?
  contactEmail       String
  contactPhone       String
  website            String?
  logoUrl            String?
  registrationNumber String?
  status             VendorStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectionReason    String?
  /// Vendor-controlled kill switch: hides every item from discover without
  /// deleting anything. Distinct from status, which only operators change.
  listingPaused      Boolean      @default(false)
  /// Settings-page preferences; shape is vendorPreferencesSchema in packages/shared.
  preferences        Json         @default("{}")
  rating             Float        @default(0)
  reviewCount        Int          @default(0)

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String? @default("Nigeria")
  postalCode   String?
  latitude     Float?
  longitude    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category?          @relation(fields: [categoryId], references: [id])
  inventoryItems InventoryItem[]
  orders         Order[]
  customers      Customer[]
  conversations  Conversation[]
  apiKeys        ApiKey[]
  syncJobs       InventorySyncJob[]
  dailyStats     VendorDailyStat[]
  checkouts      CheckoutSession[]
  payouts        VendorPayout[]

  @@index([status])
  @@index([categoryId])
  @@index([city, state])
  @@map("vendors")
}

// ---------------------------------------------------------------------------
// Catalog + inventory
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  /// lucide-react icon name, so the UI keeps rendering the same glyphs.
  icon        String?
  parentId    String?
  sortOrder   Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  vendors        Vendor[]
  products       Product[]
  inventoryItems InventoryItem[]

  @@index([parentId])
  @@map("categories")
}

/// Shared catalog entry. Several vendors stock the same Product; what each of
/// them actually has on hand lives in InventoryItem.
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  brand       String?
  categoryId  String?
  imageUrl    String?
  defaultUnit String   @default("unit")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id])
  inventoryItems InventoryItem[]

  @@index([categoryId])
  @@map("products")
}

/// The core Finder record: what this vendor has, how much, at what price.
model InventoryItem {
  id                String          @id @default(cuid())
  vendorId          String
  productId         String?
  categoryId        String?
  name              String
  sku               String?
  quantity          Int             @default(0)
  unit              String          @default("unit")
  price             Decimal         @db.Decimal(14, 2)
  currency          String          @default("NGN") @db.Char(3)
  lowStockThreshold Int             @default(10)
  status            InventoryStatus @default(IN_STOCK)
  imageUrl          String?
  notes             String?
  lastSyncedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id])
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  checkouts  CheckoutSession[]

  @@unique([vendorId, sku])
  @@index([vendorId, status])
  @@index([categoryId])
  @@index([name])
  @@map("inventory_items")
}

/// One run of the AI Inventory Sync Center — a bulk push from a vendor's own
/// POS or ERP, either through the dashboard or the public API.
model InventorySyncJob {
  id           String    @id @default(cuid())
  vendorId     String
  source       String    @default("MANUAL")
  totalItems   Int       @default(0)
  updatedItems Int       @default(0)
  createdItems Int       @default(0)
  failedItems  Int       @default(0)
  errorLog     Json?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, startedAt])
  @@map("inventory_sync_jobs")
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  vendorId    String
  /// Set when the customer also holds a Finder account.
  userId      String?
  fullName    String
  email       String?
  phone       String?
  company     String?
  notes       String?
  totalOrders Int      @default(0)
  totalSpent  Decimal  @default(0) @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([vendorId])
  @@index([email])
  @@map("customers")
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  vendorId    String
  customerId  String?
  userId      String?
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(14, 2)
  total       Decimal     @db.Decimal(14, 2)
  currency    String      @default("NGN") @db.Char(3)
  note        String?
  placedAt    DateTime    @default(now())
  fulfilledAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime    @updatedAt

  /// VENDOR = recorded by the vendor; CHECKOUT = bought and paid online.
  source           OrderSource @default(VENDOR)
  /// Paystack reference; set only on paid CHECKOUT orders.
  paymentReference String?     @unique
  paidAt           DateTime?
  fulfilment       Fulfilment?
  deliveryAddress  String?
  buyerPhone       String?

  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  items           OrderItem[]
  checkoutSession CheckoutSession?

  @@index([vendorId, status])
  @@index([customerId])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  inventoryItemId String?
  /// Denormalised so an order still reads correctly after the vendor edits or
  /// deletes the inventory line it came from.
  name            String
  sku             String?
  quantity        Int
  unitPrice       Decimal @db.Decimal(14, 2)
  lineTotal       Decimal @db.Decimal(14, 2)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

/// A buyer's "Buy now" between clicking and paying. Stock is reserved when the
/// session opens and released if it expires unpaid; the Order is only created
/// once Paystack confirms payment, so vendor-side order queries never see
/// abandoned checkouts.
model CheckoutSession {
  id              String         @id @default(cuid())
  /// Our Paystack transaction reference.
  reference       String         @unique
  userId          String
  vendorId        String
  inventoryItemId String?
  name            String
  sku             String?
  quantity        Int
  unitPrice       Decimal        @db.Decimal(14, 2)
  total           Decimal        @db.Decimal(14, 2)
  currency        String         @default("NGN") @db.Char(3)
  fulfilment      Fulfilment
  deliveryAddress String?
  buyerPhone      String
  status          CheckoutStatus @default(PENDING)
  /// Reserved stock goes back after this unless payment lands first.
  expiresAt       DateTime
  orderId         String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  order         Order?         @relation(fields: [orderId], references: [id])

  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@map("checkout_sessions")
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model Conversation {
  id            String    @id @default(cuid())
  vendorId      String
  userId        String?
  subject       String
  lastMessageAt DateTime  @default(now())
  vendorUnread  Int       @default(0)
  userUnread    Int       @default(0)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id])
  messages Message[]

  @@index([vendorId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  /// USER | VENDOR | ADMIN — who wrote it, independent of account role.
  senderType     String
  senderId       String?
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Affiliate programme
// ---------------------------------------------------------------------------

model Affiliate {
  id                  String          @id @default(cuid())
  userId              String          @unique
  code                String          @unique
  status              AffiliateStatus @default(PENDING)
  payoutEmail         String
  website             String?
  audienceDescription String?
  promotionChannels   String[]
  commissionRate      Decimal         @default(0.10) @db.Decimal(5, 4)
  balance             Decimal         @default(0) @db.Decimal(14, 2)
  totalEarned         Decimal         @default(0) @db.Decimal(14, 2)
  clickCount          Int             @default(0)
  approvedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals AffiliateReferral[]
  payouts   AffiliatePayout[]

  @@index([status])
  @@map("affiliates")
}

model AffiliateReferral {
  id           String    @id @default(cuid())
  affiliateId  String
  referredType String
  referredId   String
  commission   Decimal   @default(0) @db.Decimal(14, 2)
  converted    Boolean   @default(false)
  convertedAt  DateTime?
  createdAt    DateTime  @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@map("affiliate_referrals")
}

model AffiliatePayout {
  id          String       @id @default(cuid())
  affiliateId String
  amount      Decimal      @db.Decimal(14, 2)
  currency    String       @default("NGN") @db.Char(3)
  method      String       @default("BANK_TRANSFER")
  status      PayoutStatus @default(PENDING)
  reference   String?
  requestedAt DateTime     @default(now())
  paidAt      DateTime?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status])
  @@map("affiliate_payouts")
}

// ---------------------------------------------------------------------------
// Developer platform + partners
// ---------------------------------------------------------------------------

/// Backs /vendor/api-integrations and /developers. Only keyPrefix is ever shown
/// after creation; keyHash is what we compare against.
model ApiKey {
  id         String        @id @default(cuid())
  vendorId   String
  name       String
  keyPrefix  String        @unique
  keyHash    String        @unique
  scopes     ApiKeyScope[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("api_keys")
}

model Partner {
  id              String          @id @default(cuid())
  companyName     String
  contactName     String
  contactEmail    String
  contactPhone    String?
  website         String?
  partnershipType PartnershipType @default(OTHER)
  message         String
  status          PartnerStatus   @default(INQUIRY)
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([status])
  @@map("partners")
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

model ContactSubmission {
  id        String    @id @default(cuid())
  fullName  String
  email     String
  company   String?
  subject   String
  message   String
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([handledAt])
  @@map("contact_submissions")
}

/// Every discovery query, kept for the live ticker, trending searches and the
/// demand-signal analytics the vendor dashboard promises.
model SearchQuery {
  id          String   @id @default(cuid())
  term        String
  categoryId  String?
  city        String?
  state       String?
  resultCount Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())

  @@index([term])
  @@index([createdAt])
  @@map("search_queries")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// One row per vendor per UTC day. Discover increments impressions for every
/// vendor in a result set; the public vendor page increments profileViews.
/// Kept as counters rather than raw events so analytics stay a cheap range scan.
model VendorDailyStat {
  id           String   @id @default(cuid())
  vendorId     String
  day          DateTime @db.Date
  impressions  Int      @default(0)
  profileViews Int      @default(0)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, day])
  @@index([day])
  @@map("vendor_daily_stats")
}

/// A manual transfer from Finder to a vendor for money collected at checkout.
/// What a vendor is owed is derived: paid checkout orders (less the platform
/// fee) minus the payouts recorded here. See services/payout.service.ts.
model VendorPayout {
  id          String   @id @default(cuid())
  vendorId    String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("NGN") @db.Char(3)
  /// Bank transfer reference, for reconciling against the bank statement.
  reference   String?
  note        String?
  paidAt      DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([vendorId, currency])
  @@map("vendor_payouts")
}
