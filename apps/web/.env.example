# The browser never talks to the API directly — it calls /api/proxy on this
# app, which forwards to API_URL with the httpOnly auth cookies attached.
API_URL="http://localhost:5020"
NEXT_PUBLIC_APP_URL="http://localhost:3020"

# Public API host shown in developer snippets (the browser itself uses /api/proxy).
NEXT_PUBLIC_API_URL="http://localhost:5020"
