{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace @finder/shared && npm run db:generate --workspace @finder/api && npm run build --workspace @finder/api"
  },
  "deploy": {
    "preDeployCommand": ["npm run db:deploy --workspace @finder/api"],
    "startCommand": "npm run start --workspace @finder/api",
    "healthcheckPath": "/api/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
